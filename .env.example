# Supabase (existing storefront auth preview)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Twinklingz API — local dev (.env); production uses .env.production
VITE_API_URL=http://localhost:5000/api
# Production build: VITE_API_URL=https://api.twinklingz.com/api (see .env.production)

# Razorpay — public key for checkout (secret stays on backend)
VITE_RAZORPAY_KEY_ID=

# Optional hero video
VITE_HERO_SCROLL_VIDEO=/hero-fashion-film.mp4

# Admin routes (/admin, /admin/login) live in this same Vite app.
# API runs from sibling project: ../twinklingz-backend
